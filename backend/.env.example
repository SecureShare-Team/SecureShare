# SecureShare Backend 환경변수 템플릿
# 이 파일을 .env.development 또는 .env.production 으로 복사하여 사용하세요

# 서버 설정
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000

# 데이터베이스
DB_HOST=localhost
DB_PORT=3306
DB_NAME=secureshare_db
DB_USER=root
DB_PASSWORD=

# JWT 설정
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key
JWT_REFRESH_EXPIRE=30d

# AWS S3 설정
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=secureshare-uploads

# 파일 업로드 설정
MAX_FILE_SIZE=1073741824
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png,gif,zip

# 암호화 설정
ENCRYPTION_KEY=default-key-please-change-in-production-32chars

# 로그 설정
LOG_LEVEL=info

# 이메일 설정 (선택)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@secureshare.com

# CORS 설정
CORS_ORIGIN=http://localhost:3000

# API 속도 제한
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 세션 설정
SESSION_SECRET=your-session-secret-key-change-this

# 관리자 초기 설정
ADMIN_EMAIL=admin@secureshare.com
ADMIN_PASSWORD=AdminPassword123!
