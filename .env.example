# .env.example — 환경변수 키 이름만 정의 (실제 값 없이 커밋)
#
# 신규 팀원은 이 파일을 복사해 .env로 이름을 바꾼 후 실제 값을 채워 사용
# .env 파일은 .gitignore에 의해 커밋되지 않음
#
# 담당: 공통

# ── 서버 ───────────────────────────────────────────────────────────────────────
PORT=

# ── 데이터베이스 (RDS Proxy) ───────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── 암호화 ─────────────────────────────────────────────────────────────────────
# KEK (Key Encryption Key) — DEK를 암호화하는 마스터 키
# 절대 코드에 하드코딩 금지. 반드시 Secrets Manager 또는 환경변수로 주입
MASTER_KEY=

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=
S3_QUARANTINE_BUCKET=
S3_CLEAN_BUCKET=
S3_INFECTED_BUCKET=

# ── Cognito (JWT 검증용) ────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_REGION=
