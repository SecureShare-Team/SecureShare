{
  "name": "secureshare-backend",
  "version": "1.0.0",
  "description": "Secure file sharing platform backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "node_modules/.bin/sequelize-cli db:migrate",
    "db:seed": "node_modules/.bin/sequelize-cli db:seed:all",
    "db:migrate:undo": "node_modules/.bin/sequelize-cli db:migrate:undo:all",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "secure",
    "file",
    "sharing",
    "encryption"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "aws-sdk": "^2.1392.0",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.3.3",
    "nodemailer": "^6.9.3",
    "sequelize": "^6.31.1",
    "sequelize-cli": "^6.5.2",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "eslint": "^8.43.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  }
}
